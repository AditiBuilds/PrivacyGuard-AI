# PrivacyGuard AI Environment Configuration

# Application
PROJECT_NAME="PrivacyGuard AI"
VERSION="1.0.0"

# Database Configuration (SQLite default zero-config; PostgreSQL compatible)
DATABASE_URL="sqlite:///./privacyguard.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/privacyguard"

# Local LLM Integration (Optional)
LLM_PROVIDER="deterministic"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Bounded Agent Guardrails
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=30
MAX_INPUT_LENGTH_CHARS=100000
MAX_UPLOAD_SIZE_BYTES=5242880

# Privacy Policies & Minimization
DEFAULT_RETENTION_DAYS=30
DEFAULT_REVIEW_THRESHOLD=60
LOCAL_ONLY_PROCESSING=true
MASKING_STRATEGY="token"
